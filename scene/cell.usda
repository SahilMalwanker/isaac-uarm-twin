                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }

                def Xform "JawPoint"
                {
                    double3 xformOp:translate = (0, 0, -0.0133)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }

            def Xform "PCB" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
            )
            {
                float physics:mass = 0.1
                float physxRigidBody:angularDamping = 0.1
                float physxRigidBody:linearDamping = 0.1
                vector3f physics:velocity = (0, 0, 0)
                double3 xformOp:translate = (0.64323, 0.25398, 1.019)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "Collider" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    double size = 1
                    float physxCollision:contactOffset = 0.002
                    float physxCollision:restOffset = 0
                    token visibility = "invisible"
                    double3 xformOp:translate = (0, 0, 0)
                    float3 xformOp:scale = (0.055, 0.075, 0.01)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Board" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </World/Looks/Board>
                    double3 xformOp:translate = (0, 0, -0.0042)
                    float3 xformOp:scale = (0.055, 0.075, 0.0016)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Chip1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </World/Looks/Chip>
                    double3 xformOp:translate = (0.008, 0.012, -0.0019)
                    float3 xformOp:scale = (0.022, 0.022, 0.003)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Chip2" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </World/Looks/Chip>
                    double3 xformOp:translate = (-0.014, -0.02, -0.0024)
                    float3 xformOp:scale = (0.012, 0.016, 0.002)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Connector" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </World/Looks/Chip>
                    double3 xformOp:translate = (0, -0.031, -0.0004)
                    float3 xformOp:scale = (0.04, 0.007, 0.006)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Xform "GripPoint"
                {
                    double3 xformOp:translate = (0, 0, 0.005)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
