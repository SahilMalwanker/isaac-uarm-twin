#usda 1.0
(
    defaultPrim = "World"
    doc = """Isaac uArm Twin - robot cell, generated by tools/build_scene.py (do not edit by hand).
    Robots are referenced from ./robot (import assets/swiftpro/*.urdf with the Isaac Sim URDF importer).
    Everything else is built from primitive shapes."""
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.2)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "TableTop"
        {
            token outputs:surface.connect = </World/Looks/TableTop/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.42, 0.42)
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Frame"
        {
            token outputs:surface.connect = </World/Looks/Frame/Shader.outputs:surface>

