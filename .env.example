# Copy to .env and adjust. Every value is optional; the defaults are shown.

# Serial ports of the three uArm Swift Pro arms (Windows may renumber them after a reboot)
ARM1_PORT=COM3
ARM2_PORT=COM5
ARM3_PORT=COM4

# Telemetry service of the standalone cell demo (python -m tia_s7_twin.cell_demo)
TWIN_HOST=127.0.0.1
TWIN_PORT=8001
# Servo samples per second and arm. Every sample shares the serial link with motion commands.
TWIN_TELEMETRY_HZ=1
# 1 = drive the arms through the assembly sequences, 0 = only serve telemetry
TWIN_RUN_MOTION=1

# Endpoint the Isaac Sim follower polls (the launcher passes it on to Isaac Sim)
TWIN_TELEMETRY_URL=http://127.0.0.1:8001/api/servo_angles

# Calibration helper (python -m tia_s7_twin.calibrate)
TWIN_CALIBRATION_PORT=8002

# Isaac Sim launcher (python -m tia_s7_twin.launcher)
ISAAC_SIM_EXE=isaacsim
# Leave empty for scene/cell.usda
TWIN_SCENE=
TWIN_WAIT_TIMEOUT=60
